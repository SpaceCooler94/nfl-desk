{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NFL Desk player-prop card",
  "type": "object",
  "required": ["season", "week", "status", "card_type", "props"],
  "properties": {
    "card_type": { "const": "player_props" },
    "status": { "enum": ["SEED_PRIOR", "LIVE"] },
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "player", "team", "opp", "market", "play"],
        "properties": {
          "market": {
            "enum": [
              "pass_yds", "pass_tds", "pass_cmp", "pass_att",
              "rush_yds", "rush_att", "rec_yds", "receptions",
              "pass_rush_yds", "anytime_td"
            ]
          },
          "line": { "type": ["number", "null"] },
          "proj": { "type": ["number", "null"] },
          "edge": {
            "description": "proj - line. Positive = model likes the over.",
            "type": ["number", "null"]
          },
          "p_over": { "type": ["number", "null"] },
          "price": { "description": "American odds on the over / yes", "type": ["integer", "null"] },
          "play": { "enum": ["OVER", "UNDER", "WATCH", "PASS"] }
        }
      }
    }
  }
}
