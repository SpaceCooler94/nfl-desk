{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NFL Desk xDESK game sheet",
  "type": "object",
  "required": ["season", "week", "status", "card_type", "games", "props"],
  "properties": {
    "card_type": { "const": "player_props" },
    "status": { "enum": ["SEED_PRIOR", "LIVE"] },
    "layout": { "const": "xdesk-sheet" },
    "games": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "away", "home"],
        "properties": {
          "id": { "type": "string" },
          "when": { "type": "string" },
          "away": { "type": "string" },
          "home": { "type": "string" },
          "spread": { "type": "string" },
          "total": { "type": ["number", "string", "null"] },
          "roof": { "type": "string" },
          "away_implied": { "type": ["number", "null"] },
          "home_implied": { "type": ["number", "null"] },
          "looks": { "type": "array" }
        }
      }
    },
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "player", "team", "opp", "market", "play", "game_id"],
        "properties": {
          "market": {
            "enum": [
              "pass_yds", "pass_tds", "pass_cmp", "pass_att",
              "rush_yds", "rush_att", "rec_yds", "receptions",
              "pass_rush_yds", "anytime_td"
            ]
          },
          "line": { "type": ["number", "null"] },
          "proj": { "type": ["number", "null"] },
          "edge": { "type": ["number", "null"] },
          "p_over": { "type": ["number", "null"] },
          "play": { "enum": ["OVER", "UNDER", "WATCH", "PASS"] }
        }
      }
    }
  }
}
